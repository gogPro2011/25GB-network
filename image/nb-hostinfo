#!/bin/sh
# Описание ноды для таблицы "Стенд". Запускать в hostNetwork + hostPID поде
sec() { echo; echo "===== $*"; }

sec uname;      uname -a
sec cmdline;    cat /proc/cmdline
sec lscpu;      lscpu
sec memory;     free -g
sec governor;   cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor 2>/dev/null || echo "n/a"
sec irqbalance; pgrep -a irqbalance || echo "not running"
sec sysctl
sysctl net.core.rmem_max net.core.wmem_max net.ipv4.tcp_rmem net.ipv4.tcp_wmem \
       net.ipv4.tcp_congestion_control net.core.default_qdisc \
       net.core.netdev_max_backlog net.netfilter.nf_conntrack_max 2>/dev/null
sec "routes";   ip route
sec "calico/tunnel interfaces"
ip -d link show | grep -A2 -E ': (tunl0|vxlan\.calico|vxlan-v6\.calico|wireguard\.cali|bond[0-9]+)' || echo "none"
sec "cali* veth count"; ip -o link show | grep -c ': cali' || true

for d in /sys/class/net/*; do
  [ -e "$d/device" ] || continue
  n=${d##*/}
  sec "NIC $n"
  echo "mtu: $(cat "$d/mtu")  numa_node: $(cat "$d/device/numa_node" 2>/dev/null || echo n/a)"
  echo "--- ethtool";   ethtool "$n" 2>&1
  echo "--- driver";    ethtool -i "$n" 2>&1
  echo "--- channels";  ethtool -l "$n" 2>&1
  echo "--- rings";     ethtool -g "$n" 2>&1
  echo "--- offloads";  ethtool -k "$n" 2>&1 | grep -vE 'fixed\]$'
done

for b in /proc/net/bonding/*; do
  [ -e "$b" ] || continue
  sec "bond $b"; cat "$b"
done
